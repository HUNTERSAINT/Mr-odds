TELEGRAM_TOKEN=            # from @BotFather
GEMINI_API_KEY=            # from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-flash
CACHE_MINUTES=30
ODDS_API_KEY=              # https://the-odds-api.com (free: 500 credits/month)
DAYS_AHEAD=14            # how many days the day menu shows
ODDS_CACHE_HOURS=24        # each league fetch costs 1 credit, so cache for hours
SLIP_FRESH_HOURS=12        # leagues with games on the chosen days refresh if older than this
MAX_LEAGUES=14             # in-season leagues fetched (free plan: 500 credits/month)
CREDIT_RESERVE=40          # stop fetching below this many credits left
DB_PATH=bot.db             # on Railway: /data/bot.db (volume mounted at /data)
SETTLE_EVERY_HOURS=8
